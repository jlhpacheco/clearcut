# Private Agent Service Configuration (Example)
# This file contains non-secret names/keys and placeholders.
# Copy this to .env and configure local values before running.

ENVIRONMENT=development
USE_FIXTURES=True

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=clearcut-agentic-20260901
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro
DEMO_VIDEO_GCS_URI=gs://clearcut-bucket/clearcut-demo.mp4

# Partner Retrieval API
PARALLEL_API_KEY=YOUR_PARALLEL_API_KEY_HERE
