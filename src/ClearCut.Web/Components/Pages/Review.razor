@page "/"
@inject ReviewSessionStore Store
@inject ReportService ReportService
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>ClearCut — Independent Filmmaker Clearance Assistant</PageTitle>

<div class="screening-room-container no-print">
    <div class="sr-only" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0;" aria-live="polite">
        @_liveAnnouncement
    </div>

    @if (Configuration.GetValue<bool>("UseFixtures", false))
    {
        <div class="alert alert-warning text-center font-weight-bold p-3 mb-4" data-testid="mode-banner" style="background-color: #D97706; color: #0B0E14; letter-spacing: 0.05em; font-size: 1.1rem; border: none; border-radius: 6px; box-shadow: 0 4px 15px rgba(217, 119, 6, 0.25);" role="alert">
            FIXTURE MODE — NO LIVE SERVICES
        </div>
    }

    <!-- Header Brand Area -->
    <header class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <img src="assets/brand/clearcut-logo.png" alt="ClearCut Logo" class="brand-logo-img" />
            <h1 class="brand-text m-0">ClearCut</h1>
            <span class="demo-label mr-2">Fictional demo</span>
            <span class="scene-label">Original synthetic scene</span>
        </div>
        @if (Store.Session.Findings.Count > 0)
        {
            <button type="button" class="btn-secondary-cinematic py-1 px-3" style="font-size: 0.8rem;" @onclick="ConfirmStartOver">
                Start Over
            </button>
        }
    </header>

    <!-- Fictional Media and Workflow Intro -->
    @if (Store.Session.Findings.Count == 0)
    {
        <div class="row align-items-center mb-5" data-testid="opening">
            <div class="col-lg-7">
                <h2 class="display-6 font-weight-bold text-white mb-3">Your cut, ready for evidence review</h2>
                <p class="lead text-secondary mb-4" style="line-height: 1.5;">
                    Turn a near-final cut into timestamped research evidence and a human-reviewed checklist.
                </p>

                <div class="workflow-compact-container" data-testid="workflow">
                    <div class="workflow-compact-step">
                        <div class="workflow-compact-step-num">Step 1</div>
                        <div class="workflow-compact-step-title">Analyze cut</div>
                        <div class="workflow-compact-step-desc">Identify potential items of interest in the video.</div>
                    </div>
                    <div class="workflow-compact-step">
                        <div class="workflow-compact-step-num">Step 2</div>
                        <div class="workflow-compact-step-title">Inspect timestamps</div>
                        <div class="workflow-compact-step-desc">Review identified items at specific times.</div>
                    </div>
                    <div class="workflow-compact-step">
                        <div class="workflow-compact-step-num">Step 3</div>
                        <div class="workflow-compact-step-title">Research evidence</div>
                        <div class="workflow-compact-step-desc">Gather information and citations.</div>
                    </div>
                    <div class="workflow-compact-step">
                        <div class="workflow-compact-step-num">Step 4</div>
                        <div class="workflow-compact-step-title">Record decisions</div>
                        <div class="workflow-compact-step-desc">Document human determinations and notes.</div>
                    </div>
                    <div class="workflow-compact-step">
                        <div class="workflow-compact-step-num">Step 5</div>
                        <div class="workflow-compact-step-title">Prepare checklist</div>
                        <div class="workflow-compact-step-desc">Generate a summary of findings and decisions.</div>
                    </div>
                </div>

                <div class="disclaimer-banner">
                    ClearCut provides research assistance, not legal advice. The filmmaker remains responsible for every decision.
                </div>
                
                <div class="mt-4" aria-live="polite">
                    <button type="button" 
                            class="btn-cinematic px-4 py-3" 
                            data-testid="analyze-button"
                            disabled="@Store.IsOperationActive" 
                            @onclick="AnalyzeVideoAsync"
                            aria-label="Analyze rough cut with Gemini">
                        @if (Store.Session.IsAnalysisActive)
                        {
                            <span class="spinner-teal mr-2"></span>
                            <span>Analyzing with Gemini...</span>
                        }
                        else
                        {
                            <span>Analyze with Gemini</span>
                        }
                    </button>
                </div>
                <div class="mt-3 text-secondary small" data-testid="findings-empty">
                    Timestamped findings will appear here after analysis.
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <div class="p-4 rounded border" data-testid="clip-panel" style="background-color: var(--bg-card); border-color: var(--border-subtle) !important;">
                    <h5 class="small text-secondary font-weight-bold mb-3 uppercase" style="letter-spacing: 0.05em;">Included Film Clip</h5>
                    <VideoPlayer />
                    <p class="small text-secondary mt-3 mb-0" style="font-style: italic;">
                        Original synthetic near-final scene with three planted review questions.
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Main Workspace (Split View) -->
        <div class="disclaimer-banner">
            ClearCut provides research assistance, not legal advice. The filmmaker remains responsible for every decision.
        </div>

        <div class="screening-layout">
            <!-- Left Panel: Media & Evidence Details -->
            <div>
                <!-- Video Screen -->
                <div class="mb-4">
                    <VideoPlayer @ref="_videoPlayer" />
                </div>

                <!-- Active Finding Work Area -->
                @if (_activeFinding != null)
                {
                    var status = Store.Session.ResearchStatus.TryGetValue(_activeFinding.FindingId, out var s) ? s : "pending";
                    Store.Session.ResearchTasks.TryGetValue(_activeFinding.FindingId, out var task);
                    Store.Session.Evidence.TryGetValue(_activeFinding.FindingId, out var sources);

                    <div class="p-4 rounded border mb-4" style="background-color: var(--bg-card); border-color: var(--border-subtle) !important;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 @ref="_activeHeadingRef" tabindex="-1" class="h5 m-0 text-white" style="outline: none;">Active Research: @_activeFinding.Label</h3>
                            
                            @if (status == "pending" || status == "incomplete")
                            {
                                <button type="button" 
                                        class="btn-cinematic py-1 px-3" 
                                        data-testid="research-action"
                                        disabled="@Store.IsOperationActive" 
                                        @onclick="ResearchFindingAsync">
                                    Research with Parallel
                                </button>
                            }
                        </div>

                        <!-- 4-Stage Research Timeline -->
                        <ResearchTimeline Status="@status" ResearchTask="@task" />

                        <!-- Evidence Sources -->
                        <EvidenceCard Sources="@sources" />

                        <!-- Human Disposition Panel -->
                        @{
                            Store.Session.Dispositions.TryGetValue(_activeFinding.FindingId, out var disp);
                            Store.Session.ReviewerNotes.TryGetValue(_activeFinding.FindingId, out var note);
                            var canDismiss = Store.CanDismiss(_activeFinding.FindingId);
                        }
                        <DispositionPanel FindingId="@_activeFinding.FindingId"
                                          SelectedDisposition="@disp"
                                          ReviewerNote="@note"
                                          CanDismiss="@canDismiss"
                                          OnDispositionChanged="((d) => SetDispositionAndAnnounce(_activeFinding, d))"
                                          OnNoteChanged="((n) => Store.SetReviewerNote(_activeFinding.FindingId, n))" />
                    </div>
                }
            </div>

            <!-- Right Panel: Chronological Findings List & Checklist -->
            <div>
                <h3 class="h6 text-secondary uppercase font-weight-bold mb-3" style="letter-spacing: 0.05em;">Timeline Findings</h3>
                
                <div class="findings-scroll-container mb-4" data-testid="findings-list" style="max-height: 500px; overflow-y: auto;">
                    @foreach (var finding in Store.Session.Findings)
                    {
                        var isActive = _activeFinding?.FindingId == finding.FindingId;
                        var status = Store.Session.ResearchStatus.TryGetValue(finding.FindingId, out var s) ? s : "pending";
                        Store.Session.Evidence.TryGetValue(finding.FindingId, out var sources);
                        var srcCount = sources?.Count ?? 0;

                        <FindingCard Finding="@finding"
                                     IsActive="@isActive"
                                     ResearchStatus="@status"
                                     SourceCount="@srcCount"
                                     OnSelect="(() => SelectFinding(finding))" />
                    }
                </div>

                <!-- Live Clearance Checklist & Print Button -->
                <div data-testid="checklist">
                    <ClearanceChecklist Findings="@Store.Session.Findings"
                                    Dispositions="@Store.Session.Dispositions"
                                    ResearchStatuses="@Store.Session.ResearchStatus"
                                    Evidence="@Store.Session.Evidence"
                                    IsReadyToExport="@Store.CanPrint()" />
                </div>
            </div>
        </div>
    }

    <!-- Analysis Failed State -->
    @if (!string.IsNullOrEmpty(Store.Session.AnalysisError))
    {
        <div class="alert alert-danger p-4 rounded border mt-4 text-center" aria-live="assertive" style="background-color: rgba(225, 29, 72, 0.1); border-color: var(--priority-check); max-width: 600px; margin: 0 auto;">
            <h4 class="h5 mb-2" style="color: #FB7185;">@Store.Session.AnalysisError</h4>
            <p class="small text-secondary mb-3">Please retry clip analysis to organize candidate timeline findings.</p>
            <button type="button" class="btn-cinematic px-4 py-2" @onclick="AnalyzeVideoAsync">
                Retry Analysis
            </button>
        </div>
    }

    <!-- Start Over Confirmation Dialog Modal -->
    @if (_showStartOverConfirm)
    {
        <div class="modal d-block" data-testid="reset-dialog" style="background-color: rgba(11, 14, 20, 0.85); z-index: 1050;" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="start-over-title">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-subtle); color: var(--text-primary);">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title font-weight-bold" id="start-over-title">Start Over?</h5>
                        <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="(() => _showStartOverConfirm = false)"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-secondary">This action will clear all current review findings, retrieved evidence sources, human dispositions, and reviewer notes. This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer border-top-0 d-flex justify-content-end gap-2">
                        <button type="button" @ref="_cancelButtonRef" class="btn-secondary-cinematic py-1 px-3" @onclick="(() => _showStartOverConfirm = false)">Cancel</button>
                        <button type="button" class="btn-cinematic py-1 px-3" @onclick="ConfirmReset">Confirm Start Over</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Print-Only Page Layout -->
<div class="print-only">
    @{
        var report = ReportService.GenerateReport(Store.Session);
    }
    <div class="print-header">
        <h1 class="print-title">ClearCut Clearance Preparation Report</h1>
        <p class="print-meta">Project: @report.ProjectName | Date: @report.ExportDate</p>
    </div>

    @foreach (var item in report.Items)
    {
        <div class="print-finding-row">
            <div class="d-flex justify-content-between align-items-start">
                <h3 class="print-finding-title">@item.Timeframe: @item.Label</h3>
                <span class="print-finding-disposition">@item.Disposition</span>
            </div>
            
            <p class="print-finding-detail"><strong>Category:</strong> @item.Category | <strong>Research Status:</strong> @item.ResearchStatus</p>
            <p class="print-finding-detail"><strong>Observation:</strong> @item.Observation</p>
            <p class="print-finding-detail"><strong>Reviewer Notes:</strong> @item.ReviewerNote</p>

            @if (item.Sources.Count > 0)
            {
                <div class="print-evidence-section">
                    <h4 class="small font-weight-bold mb-2">Retrieved Sources:</h4>
                    @foreach (var src in item.Sources)
                    {
                        <div class="print-source">
                            <strong>@src.Title</strong> (@src.Publisher)<br />
                            <span class="text-muted">Source URL: @src.Url</span><br />
                            @src.RelevanceSummary
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="print-disclaimer">
        <strong>Disclaimer:</strong> @report.Disclaimer
    </div>
</div>

@code {
    private VideoPlayer? _videoPlayer;
    private ReviewFinding? _activeFinding;
    private bool _showStartOverConfirm;
    private bool _isDisposed;

    private string _liveAnnouncement = "";
    private string? _lastAnnouncedStatusKey = null;
    private double? _pendingSeekSeconds;

    private ElementReference _activeHeadingRef;
    private ElementReference _cancelButtonRef;

    protected override void OnInitialized()
    {
        Store.OnChange += OnStoreChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Store.Session.Findings.Count > 0)
        {
            _activeFinding = Store.Session.Findings.FirstOrDefault();
            if (_activeFinding != null)
            {
                _pendingSeekSeconds = _activeFinding.StartSeconds;
            }
            StateHasChanged();
        }

        if (_videoPlayer != null && _pendingSeekSeconds.HasValue)
        {
            var seconds = _pendingSeekSeconds.Value;
            _pendingSeekSeconds = null;
            await _videoPlayer.SeekToAsync(seconds);
        }
    }

    private void OnStoreChange()
    {
        if (_isDisposed) return;

        if (_activeFinding == null && Store.Session.Findings.Count > 0)
        {
            _activeFinding = Store.Session.Findings.FirstOrDefault();
        }

        if (_activeFinding != null)
        {
            var findingId = _activeFinding.FindingId;
            var status = Store.Session.ResearchStatus.TryGetValue(findingId, out var s) ? s : "pending";
            var statusKey = $"{findingId}:{status}";

            if (_lastAnnouncedStatusKey != statusKey)
            {
                _lastAnnouncedStatusKey = statusKey;
                if (status == "preparing")
                {
                    _liveAnnouncement = "Preparing research task...";
                }
                else if (status == "searching")
                {
                    _liveAnnouncement = "Searching with Parallel...";
                }
                else if (status == "reviewing")
                {
                    _liveAnnouncement = "Reviewing sources...";
                }
                else if (status == "ready")
                {
                    Store.Session.Evidence.TryGetValue(findingId, out var sources);
                    _liveAnnouncement = $"Research completed. {sources?.Count ?? 0} evidence sources are ready for {_activeFinding.Label}.";
                }
                else if (status == "incomplete")
                {
                    _liveAnnouncement = $"Research was incomplete or encountered an error for {_activeFinding.Label}.";
                }
            }
        }
        else if (Store.Session.Findings.Count == 0 && string.IsNullOrEmpty(Store.Session.AnalysisError))
        {
            _liveAnnouncement = "";
            _lastAnnouncedStatusKey = null;
        }

        InvokeAsync(() => {
            if (!_isDisposed)
            {
                StateHasChanged();
            }
        });
    }

    private async Task AnalyzeVideoAsync()
    {
        _activeFinding = null;
        _liveAnnouncement = "Analyzing rough cut with Gemini...";
        await Store.BeginAnalysisAsync();
        if (Store.Session.Findings.Count > 0)
        {
            _activeFinding = Store.Session.Findings.First();
            _pendingSeekSeconds = _activeFinding.StartSeconds;
            _liveAnnouncement = $"Analysis completed. {Store.Session.Findings.Count} findings identified on the timeline.";

            await Task.Delay(100);
            try
            {
                await _activeHeadingRef.FocusAsync();
            }
            catch { }
        }
        else if (!string.IsNullOrEmpty(Store.Session.AnalysisError))
        {
            _liveAnnouncement = $"Analysis failed: {Store.Session.AnalysisError}";
        }
    }

    private async Task ResearchFindingAsync()
    {
        if (_activeFinding == null) return;
        _liveAnnouncement = $"Starting Parallel Search research for: {_activeFinding.Label}";
        await Store.BeginResearchAsync(_activeFinding.FindingId);
    }

    private async Task SelectFinding(ReviewFinding finding)
    {
        _activeFinding = finding;
        _pendingSeekSeconds = finding.StartSeconds;
        _liveAnnouncement = $"Selected finding: {finding.Label} at {ReportService.FormatTimeframe(finding.StartSeconds, finding.EndSeconds)}.";

        await Task.Delay(50);
        try
        {
            await _activeHeadingRef.FocusAsync();
        }
        catch { }
        StateHasChanged();
    }

    private void SetDispositionAndAnnounce(ReviewFinding finding, Disposition? disposition)
    {
        Store.SetDisposition(finding.FindingId, disposition);
        _liveAnnouncement = $"Disposition for {finding.Label} set to {(disposition.HasValue ? disposition.Value.ToString() : "Pending")}.";
    }

    private async Task ConfirmStartOver()
    {
        _showStartOverConfirm = true;
        _liveAnnouncement = "Start over confirmation prompt opened.";
        await Task.Delay(50);
        try
        {
            await _cancelButtonRef.FocusAsync();
        }
        catch { }
    }

    private async Task ConfirmReset()
    {
        _showStartOverConfirm = false;
        _activeFinding = null;
        _pendingSeekSeconds = 0;
        _liveAnnouncement = "Review session reset. Started over.";
        Store.Reset();
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        _isDisposed = true;
        Store.OnChange -= OnStoreChange;
    }
}
