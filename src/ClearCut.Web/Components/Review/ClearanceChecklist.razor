@inject IJSRuntime JSRuntime

<div class="p-3 rounded border mb-4" style="background-color: var(--bg-card); border-color: var(--border-subtle) !important;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="small text-secondary font-weight-bold mb-0 uppercase" style="letter-spacing: 0.05em;">Review Checklist & Export</h5>
        <span class="badge-cinematic @(IsReadyToExport ? "badge-brand" : "badge-routine")" style="font-size: 0.75rem;">
            @(IsReadyToExport ? "Ready to Export" : "Incomplete (Pending Reviews)")
        </span>
    </div>

    <div class="table-responsive" tabindex="0" role="region" aria-label="Clearance review checklist table">
        <table class="table table-dark table-striped mb-3" style="font-size: 0.82rem; background-color: rgba(11, 14, 20, 0.4); border: 1px solid var(--border-subtle);">
            <thead>
                <tr style="border-bottom: 2px solid var(--border-subtle);">
                    <th scope="col" style="color: var(--text-secondary); font-weight: 600; padding: 10px;">Time</th>
                    <th scope="col" style="color: var(--text-secondary); font-weight: 600; padding: 10px;">Category</th>
                    <th scope="col" style="color: var(--text-secondary); font-weight: 600; padding: 10px;">Observation</th>
                    <th scope="col" style="color: var(--text-secondary); font-weight: 600; padding: 10px; text-align: center;">Research</th>
                    <th scope="col" style="color: var(--text-secondary); font-weight: 600; padding: 10px; text-align: right;">Disposition</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var finding in Findings)
                {
                    Dispositions.TryGetValue(finding.FindingId, out var disp);
                    ResearchStatuses.TryGetValue(finding.FindingId, out var status);
                    Evidence.TryGetValue(finding.FindingId, out var sources);
                    var srcCount = sources?.Count ?? 0;

                    <tr style="border-bottom: 1px solid var(--border-subtle); vertical-align: middle;">
                        <td style="padding: 10px; font-weight: 600; white-space: nowrap;">
                            @ReportService.FormatTimeframe(finding.StartSeconds, finding.EndSeconds)
                        </td>
                        <td style="padding: 10px;">
                            @finding.GetCategoryDisplayName()
                        </td>
                        <td style="padding: 10px; color: var(--text-secondary);">
                            @finding.Label
                        </td>
                        <td style="padding: 10px; text-align: center; white-space: nowrap;">
                            @if (status == "ready")
                            {
                                <span class="text-teal" style="color: var(--teal-primary); font-weight: 500;">Ready (@srcCount)</span>
                            }
                            else if (status == "incomplete")
                            {
                                <span style="color: #F43F5E; font-weight: 500;">Incomplete</span>
                            }
                            else if (status == "pending")
                            {
                                <span class="text-muted">None</span>
                            }
                            else
                            {
                                <span class="text-info">Active...</span>
                            }
                        </td>
                        <td style="padding: 10px; text-align: right; font-weight: bold; white-space: nowrap; color: @(disp == null ? "var(--text-secondary)" : "var(--teal-primary)")">
                            @(disp?.ToString() ?? "Pending Review")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!IsReadyToExport)
    {
        var pendingCount = Findings.Count - Dispositions.Values.Count(d => d != null);
        <p class="small text-secondary mb-3" style="line-height: 1.4;">
            <span class="text-amber" style="color: #F59E0B; font-weight: 600;">Export Locked:</span> You must assign a human disposition to all three findings in order to unlock printing. (@pendingCount left to review)
        </p>
    }

    <div class="d-flex justify-content-end">
        <button type="button" 
                class="btn-cinematic" 
                data-testid="export-report"
                disabled="@(!IsReadyToExport)" 
                @onclick="PrintReportAsync">
            Export Printable Report
        </button>
    </div>
</div>

@code {
    [Parameter] public List<ReviewFinding> Findings { get; set; } = new();
    [Parameter] public Dictionary<string, Disposition?> Dispositions { get; set; } = new();
    [Parameter] public Dictionary<string, string> ResearchStatuses { get; set; } = new();
    [Parameter] public Dictionary<string, List<EvidenceSource>> Evidence { get; set; } = new();
    [Parameter] public bool IsReadyToExport { get; set; }

    private async Task PrintReportAsync()
    {
        if (!IsReadyToExport) return;
        await JSRuntime.InvokeVoidAsync("videoInterop.triggerPrint");
    }
}
