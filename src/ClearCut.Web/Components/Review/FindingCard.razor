<button type="button"
        data-testid="finding-card"
        class="cinematic-card mb-3 w-100 text-start @(IsActive ? "active" : "")"
        @onclick="(() => OnSelect.InvokeAsync())"
        aria-pressed="@(IsActive ? "true" : "false")"
        style="background-color: @(IsActive ? "var(--bg-card-active)" : "var(--bg-card)"); border: 1px solid @(IsActive ? "var(--teal-primary)" : "var(--border-subtle)"); border-radius: 8px; padding: 1.25rem; transition: all 0.25s ease-in-out; text-align: left; display: block; color: inherit; width: 100%;">
    
    <span class="d-flex justify-content-between align-items-center mb-2">
        <span class="badge-cinematic @GetCategoryBadgeClass()">
            @Finding.GetCategoryDisplayName()
        </span>
        <span class="badge-cinematic @GetPriorityBadgeClass()">
            @Finding.GetPriorityDisplayName()
        </span>
    </span>

    <span class="h6 mb-1 text-white d-block">@Finding.Label</span>
    <span class="small text-secondary mb-2 d-block">@Finding.Observation</span>

    <span class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: var(--border-subtle) !important;">
        <span class="small text-white" style="font-weight: 600;">
            Time: @ReportService.FormatTimeframe(Finding.StartSeconds, Finding.EndSeconds)
        </span>
        <span class="small" style="font-size: 0.75rem; font-weight: 500; color: @GetStatusColor()">
            @GetResearchStatusText()
        </span>
    </span>
</button>

@code {
    [Parameter] public ReviewFinding Finding { get; set; } = null!;
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public string ResearchStatus { get; set; } = "pending";
    [Parameter] public int SourceCount { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }

    private string GetCategoryBadgeClass()
    {
        return Finding.Category switch
        {
            "brand_mark" => "badge-brand",
            "factual_claim" => "badge-claim",
            "music_cue" => "badge-music",
            _ => "badge-secondary"
        };
    }

    private string GetPriorityBadgeClass()
    {
        return Finding.ReviewPriority switch
        {
            "routine" => "badge-routine",
            "attention" => "badge-attention",
            "priority" => "badge-priority",
            _ => "badge-secondary"
        };
    }

    private string GetStatusColor()
    {
        return ResearchStatus switch
        {
            "ready" => "var(--teal-primary)",
            "preparing" => "#38BDF8",
            "searching" => "#38BDF8",
            "reviewing" => "#38BDF8",
            "incomplete" => "#F43F5E",
            _ => "var(--text-secondary)"
        };
    }

    private string GetResearchStatusText()
    {
        return ResearchStatus switch
        {
            "pending" => "Not Researched",
            "preparing" => "Preparing...",
            "searching" => "Searching...",
            "reviewing" => "Reviewing...",
            "ready" => $"Evidence Ready ({SourceCount} {(SourceCount == 1 ? "Source" : "Sources")})",
            "incomplete" => "Evidence Incomplete",
            _ => "Unknown"
        };
    }
}
