@inject IJSRuntime JSRuntime

<div class="video-frame">
    <!-- Cinematic Placeholder Screen that does not request 0-byte MP4 -->
    <div class="cinematic-placeholder-screen d-flex flex-column justify-content-center align-items-center p-4">
        <div class="monitor-signal text-uppercase">● Screening Monitor — Input Active</div>
        <div class="fictional-media-indicator">FICTIONAL DEMO — NOT LEGAL ADVICE</div>
        <div class="timecode">@FormattedTime</div>
        
        <div class="current-scene-description mt-3 text-center">
            @GetSceneDescription()
        </div>
        
        <!-- Timeline Track Visualizer with interactive planted marker highlights -->
        <div class="timeline-visual mt-4 w-100">
            <div class="timeline-bar">
                <div class="timeline-progress" style="width: @GetProgressPercentage()%;"></div>
                <button type="button" class="timeline-marker brand-marker" style="left: 11.8%;" title="LumaLeaf Logo (4.5s)" @onclick="(() => SeekToAsync(4.5))" aria-label="Seek to fictional brand finding at 4.5 seconds"></button>
                <button type="button" class="timeline-marker claim-marker" style="left: 39.4%;" title="76% Claim (15.0s)" @onclick="(() => SeekToAsync(15.0))" aria-label="Seek to factual claim finding at 15 seconds"></button>
                <button type="button" class="timeline-marker music-marker" style="left: 65.7%;" title="Ambient Synth (25.0s)" @onclick="(() => SeekToAsync(25.0))" aria-label="Seek to original music cue finding at 25 seconds"></button>
            </div>
            <div class="d-flex justify-content-between text-secondary small mt-1" style="font-size: 0.75rem;">
                <span>0.0s</span>
                <span>15.0s</span>
                <span>30.0s</span>
                <span>38.0s</span>
            </div>
        </div>
    </div>
    
    <div class="video-overlay-text d-flex justify-content-between px-3 py-1 w-100" style="position: absolute; bottom: 0; top: auto; background: rgba(11, 14, 20, 0.9); border-radius: 0; border: none; border-top: 1px solid var(--border-subtle);">
        <span>SCREENING ROOM: CLEARCUT_DEMO_CUT_V1.MP4</span>
        <span style="color: var(--teal-primary);">DURATION: 38.0s</span>
    </div>
</div>

@code {
    private double _currentTime;
    
    private string FormattedTime => ReportService.FormatSeconds(_currentTime);

    private double GetProgressPercentage()
    {
        return (_currentTime / 38.0) * 100.0;
    }

    private string GetSceneDescription()
    {
        if (_currentTime < 4.5)
            return "Opening Scene: Neon-lit futuristic city. Camera pans slowly down a cyberpunk alleyway.";
        if (_currentTime < 15.0)
            return "Scene 1 [Brand Mark]: Digital billboard flickers, displaying the glowing green 'LumaLeaf Energy' stylized leaf logo.";
        if (_currentTime < 25.0)
            return "Scene 2 [Factual Claim]: Screen displays infographic claiming '76% more energy efficient than traditional sources', citing LumaLeaf Energy study.";
        return "Scene 3 [Music Cue]: Futuristic transport vehicle speeds by. Cinematic electronic ambient background synth track builds.";
    }

    public async Task SeekToAsync(double seconds)
    {
        _currentTime = seconds;
        StateHasChanged();
        await Task.CompletedTask;
    }
}
